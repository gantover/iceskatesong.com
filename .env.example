# Copy to .env (git-ignored). Compose works without it on a dev machine; the box must set real values.

# Postgres. Compose builds each service's DATABASE_URL from these; keep the password URL-safe.
POSTGRES_USER=iceskatesong
POSTGRES_PASSWORD=iceskatesong
POSTGRES_DB=iceskatesong
POSTGRES_PORT=5432

# Host-side tools (pnpm dev, pnpm test, pnpm db:types) reach the Compose Postgres here.
# Same user, password and database as POSTGRES_* above: change both together.
DATABASE_URL=postgres://iceskatesong:iceskatesong@localhost:5432/iceskatesong

# web
WEB_PORT=8080
ORIGIN=http://localhost:8080
# Cloudflare Access in front of /admin. Unset, /admin answers 403.
# Team domain like https://<team>.cloudflareaccess.com; the AUD tag is on the Access application's overview page.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# `pnpm dev` only (ignored in a build): skip the Access check on /admin.
# ADMIN_DEV_BYPASS=true

# import
# Named in the crawler's User-Agent so the ISU can reach us. An Import fails without it.
IMPORT_CONTACT_EMAIL=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=

# The box only: starts backup and cloudflared too. Leave unset on a dev machine.
# COMPOSE_PROFILES=prod

# backup: nightly pg_dump to Cloudflare R2 under postgres/, 30-day retention.
# The endpoint is https://<account id>.r2.cloudflarestorage.com; the token needs object read/write on the bucket.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Pinged after each successful backup; set the check's period to 1 day.
HEALTHCHECKS_URL=

# cloudflared: the Tunnel's token. Point its public hostname at http://web:3000 (the Compose network name).
CLOUDFLARE_TUNNEL_TOKEN=
