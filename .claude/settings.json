{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(pnpm *)",
			"Bash(uv run *)",
			"Bash(docker compose *)",
			"Bash(psql *)",
			"Bash(gh issue *)"
		],
		"ask": [
			"Bash(ssh *)",
			"Bash(*deploy*)"
		]
	},
	"autoMemoryEnabled": false,
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git-checkout.sh"
					}
				]
			}
		]
	}
}
